node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/
.playwright-mcp/

# emdash worktree config (local)
.emdash.json

# local git worktrees
.claude/worktrees/

# pr-self-review verdict memoization (local state, not a shared report)
.claude/pr-self-review.local.md

# local brainstorm companion sessions
.superpowers/

# Agent run reports (implementer, test-writer, architecture-reviewer). Working
# artifacts, not docs: they exist so a truncated chat message costs a Read
# instead of a re-run. Plans in docs/plans/ are the durable record and stay
# committed — and so are plan-verifier's verdicts, which is why they live in
# docs/verification/ and NOT here. If you give an agent a new Write path, run
# `git check-ignore -v <path>` once: docs/reports/ silently swallowed every
# plan-verifier report until 2026-08-26.
docs/reports/

# Per-track plan extracts written by /run-plan — generated verbatim from the
# plan at dispatch time, never edited by hand, never a source of truth.
docs/plans/.extract/

# Design mockups handed to /spec-creator. They are inputs to a spec interview,
# not repository artifacts — a spec's "Design sources" table names them by path
# and that path resolves only on the machine the interview ran on.
img/
